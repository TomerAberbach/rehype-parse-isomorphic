{
  "name": "rehype-parse-isomorphic",
  "version": "1.0.0",
  "author": {
    "name": "Tomer Aberbach",
    "email": "tomer@aberba.ch",
    "url": "https://tomeraberba.ch"
  },
  "description": "A module that exports rehype-parse for Node.js and rehype-dom-parse for the browser.",
  "keywords": [
    "ast",
    "browser",
    "html",
    "isomorphic",
    "plugin",
    "rehype",
    "rehype-dom-parse",
    "rehype-parse",
    "rehype-plugin"
  ],
  "homepage": "https://github.com/TomerAberbach/rehype-parse-isomorphic",
  "repository": "TomerAberbach/rehype-parse-isomorphic",
  "bugs": {
    "url": "https://github.com/TomerAberbach/rehype-parse-isomorphic/issues"
  },
  "funding": {
    "url": "https://github.com/sponsors/TomerAberbach"
  },
  "license": "Apache-2.0 AND MIT",
  "files": [
    "src",
    "license-apache",
    "license-mit",
    "notice-apache"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">= 22"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "node": "./src/node.js",
      "browser": "./src/browser.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "prettier --cache --write .",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix .",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@tomer/prettier-config",
  "dependencies": {
    "rehype-dom-parse": "^5.0.2",
    "rehype-parse": "^9.0.1"
  },
  "devDependencies": {
    "@tomer/eslint-config": "^4.1.1",
    "@tomer/prettier-config": "^4.0.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
